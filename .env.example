# Railway production only. On Railway use the Postgres.DATABASE_URL reference.
# For native development use scripts/with-production-db.ts (private SSH relay).
DATABASE_URL=
# Optional: set only on the server; never use NEXT_PUBLIC_ for API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Local / judge run (docker compose, or a local Postgres) ---
# Uncomment for `docker compose up` (matches docker-compose.yml's db service) or any other
# local Postgres. APOLLON_LOCAL_DB=1 opts getDb() into accepting a non-Railway host.
# DATABASE_URL=postgresql://apollon:apollon@localhost:5433/apollon
# APOLLON_LOCAL_DB=1
